{
  "name": "Xpences | AI Expense Tracker",
  "short_name": "Xpences",
  "description": "Track expenses by chat, voice, receipt photo or bKash/Nagad SMS.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#1F1410",
  "theme_color": "#F97C45",
  "share_target": {
    "action": "/",
