# VITE_AI_WORKER_URL: Address of the AI server in /ai-server (it holds the Gemini key).
# For local testing run `npm run dev` inside /ai-server and use http://localhost:8787
VITE_AI_WORKER_URL="http://localhost:8787"

# VITE_GOOGLE_CLIENT_ID: the OAuth "Web client" ID from Google Cloud, used to link Google Drive and Sheets
# (Profile > Connected apps). It is public; the matching secret lives only in the AI server.
VITE_GOOGLE_CLIENT_ID=""
