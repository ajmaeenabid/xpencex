node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example
# The phone app's settings for release builds: public addresses only, no secrets
!.env.production

# Office lock files
~$*

# AI server: local secrets and Wrangler's working files
.dev.vars
# Firebase service account keys (admin access): never commit these
*firebase-adminsdk*.json
*service-account*.json
ai-server/node_modules/
ai-server/.wrangler/

# Old code kept for reference, from before Google sign-in
backup-before-google-signin/

# Firebase VS Code extension working files
.firebase/

# Android release: the signing key and its passwords must never be committed. Keep a copy somewhere safe:
# without it you can never update the app on people's phones.
*.jks
*.keystore
android/keystore.properties
# The built app file is uploaded to Firebase Hosting, not kept in git
public/download/*.apk
# Android Studio build output (the app file is made with npm run android:release)
android/app/release/
