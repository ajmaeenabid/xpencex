// The download site: the download page and the app file, as plain files on Cloudflare (free).
// Kept apart from ai-server/ on purpose, so publishing it can never touch the AI server.
// Publish with `npm run release:site` (it builds dist/ first).
{
  "name": "xpencex",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "../dist",
    "not_found_handling": "single-page-application"
  }
}
